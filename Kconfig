config ZMK_FEATURE_TYPING_HEATMAP
    bool "Enable typing statistics"
    select ZMK_LOW_PRIORITY_WORK_QUEUE if !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL

if ZMK_FEATURE_TYPING_HEATMAP

config ZMK_FEATURE_TYPING_HEATMAP_STUDIO_RPC
    bool "Enable typing statistics custom Studio RPC"
    depends on ZMK_STUDIO

config ZMK_FEATURE_TYPING_HEATMAP_SAVE_INTERVAL_SECONDS
    int "Minimum seconds between automatic statistics saves"
    range 60 86400
    default 1800

config ZMK_FEATURE_TYPING_HEATMAP_MIN_PRESSES
    int "Minimum unsaved presses before an automatic save"
    range 1 1000000
    default 100

config ZMK_FEATURE_TYPING_HEATMAP_TEST
    bool "Emit statistics for native simulator event tests"
    depends on ARCH_POSIX

config ZMK_FEATURE_TYPING_HEATMAP_BLE_TEST
    bool "Initialize settings before BLE in the BabbleSim test fixture"
    depends on ARCH_POSIX && ZMK_BLE && SETTINGS
    help
      Test-only compatibility shim for the selected ZMK baseline's BLE profile
      registration order. Do not enable this for production firmware.

# The split-relay sample (src/split/template_relay.c) has no Kconfig of its
# own: it follows ZMK's CONFIG_ZMK_SPLIT_RELAY_EVENT directly. Enable that
# explicitly on BOTH split halves to compile it (the central additionally
# needs ZMK_FEATURE_TYPING_HEATMAP_STUDIO_RPC for the RPC that triggers the relay).

endif
